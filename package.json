{
  "name": "pi-code-render",
  "version": "0.1.7",
  "description": "Render fenced code blocks in Pi's transcript as styled, flush-edge cards with one-click copy and a raw-text toggle.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "coding-agent",
    "terminal-ui",
    "tui",
    "code-blocks",
    "code-rendering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengyayu/pi-code-render.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "extensions",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-code-render.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
